{
  // ══════════════════════════════════════════════════════════════════════
  //  Cloudflare Worker 설정
  // ══════════════════════════════════════════════════════════════════════
  //
  //  ⚠ 아래 "name" 을 대시보드에 있는 내 Worker 이름과 똑같이 맞추세요.
  //    다르면 배포할 때 같은 이름의 Worker 가 새로 만들어집니다.
  //
  //    확인 방법: Cloudflare 대시보드 → Workers & Pages → 내 사이트 클릭
  //               → 위쪽에 크게 적힌 이름이 그것입니다.
  //
  //  이 파일은 Git 연동 Worker 의 "설정 원본" 입니다. 대시보드에서 바인딩을
  //  추가해도 저장되지 않고 붙여넣을 스니펫만 보여주는 이유가 이것입니다.
  //  R2 연결(r2_buckets)도 여기에 적어야 실제로 반영됩니다.
  //
  //  Pages 프로젝트라면 이 파일은 무시됩니다 — Pages 는 pages_build_output_dir
  //  키가 있을 때만 이 파일을 배포 설정으로 씁니다. 일부러 넣지 않았습니다.
  //
  "name": "ai-leaders-academy",

  // /api 요청을 처리할 코드. 나머지 요청은 아래 assets 가 처리합니다.
  "main": "shared/worker-entry.js",
  "compatibility_date": "2026-08-01",

  // 사이트 파일(HTML·CSS·JS)을 그대로 서비스합니다.
  // 공개하면 안 되는 폴더는 .assetsignore 에 적어 두었습니다.
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },

  // /api/* 는 정적 파일보다 먼저 Worker 가 받도록 명시합니다.
  // (같은 이름의 파일이 실수로 생겨도 API 가 가려지지 않습니다.)
  "run_worker_first": ["/api/*"],

  // 과제 첨부와 강의자료를 담을 R2 버킷.
  // binding 은 코드가 찾는 이름이라 반드시 BUCKET 이어야 합니다.
  // bucket_name 은 대시보드에서 만든 실제 버킷 이름입니다.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "assignment-hub"
    }
  ]

  // 강의자료 다운로드를 서버에서 잠그려면 (선택):
  //   MATERIALS_PASSWORD 와 TOKEN_SECRET 을 Secret 으로 추가하세요.
  //   비밀값이므로 이 파일에 적지 말고 대시보드나 CLI 로 넣습니다.
  //     Settings → Variables and Secrets → Add → 타입 Secret
}
